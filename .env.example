# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# The key is read by docker compose and passed to the WORKER container only.
# The API never talks to the model, so it never sees this — one fewer process
# that can leak it — and it never reaches the browser. Never prefix a secret
# with VITE_ — anything with that prefix is inlined into the client bundle and
# is fully public.

ANTHROPIC_API_KEY=sk-ant-...

# debug | info | warning | error
LOG_LEVEL=info

# console (human-readable, for local dev) | json (for anywhere else)
LOG_FORMAT=console

