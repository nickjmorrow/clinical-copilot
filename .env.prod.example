# Copy to .env.prod and fill in, then:
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build -d
#
# Every value here is required except where a default is noted. The compose file
# refuses to start rather than quietly defaulting a password — unlike the
# development stack, where app/app/app is fine precisely because nothing is
# exposed beyond your machine.

POSTGRES_USER=app
# Read ONCE, when the database volume is first created. Changing it later
# does not change the database's password — it only makes every connection
# fail with "password authentication failed". To rotate it, ALTER USER inside
# Postgres first, then change it here.
POSTGRES_PASSWORD=
POSTGRES_DB=app

# Read by the WORKER only. The API never talks to the model, so it never sees
# this — one fewer process that can leak it.
ANTHROPIC_API_KEY=sk-ant-...

# The origin browsers will actually use. Sets CORS on the API.
PUBLIC_ORIGIN=https://example.com

# Host port nginx binds to. Put TLS in front of this — your platform's load
# balancer, or Caddy — rather than terminating it in the container.
PUBLIC_PORT=80

# Which interface that port is published on. 127.0.0.1 when a TLS proxy on the
# same host (Caddy) sits in front — otherwise the plain-HTTP port is reachable
# from outside past ufw, because Docker writes its own iptables rules.
# PUBLIC_BIND_ADDRESS=0.0.0.0

# debug | info | warning | error. Logs are JSON in production.
LOG_LEVEL=info

# ------------------------------------------------------------ public mode
#
# On unless you turn it off: every browser gets its own anonymous identity
# (an HttpOnly cookie), holds no roles, and cannot see anyone else's
# conversations. Visitors can read the definitions but not change them; the
# unresolved-term report and the raw patient table are closed to them.
# VISITOR_MODE=true

# Send the visitor cookie over HTTPS only. Leave on; http://localhost counts
# as secure in browsers, so local testing works as-is.
# VISITOR_COOKIE_SECURE=true

# Cost ceilings. Per visitor per hour, and input + output tokens across
# everyone per UTC day. A tool-using turn is typically tens of thousands of
# tokens, because each model call re-sends the prompt, the tools and the
# history. ALSO set a monthly spend limit in the Anthropic console: these are
# checked between turns, so a turn in flight can overshoot them; that one
# cannot be overshot.
# MESSAGES_PER_HOUR=30
# DAILY_TOKEN_BUDGET=2000000
